name: Build Signed Android APK

on:
  workflow_dispatch:
  push:
    tags:
      - "v*"

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest

    env:
      JAVA_HOME: ${{ steps.setup-java.outputs.path }}

    steps:
      # ------------------------
      # Checkout
      # ------------------------
      - name: Checkout repo
        uses: actions/checkout@v4

      # ------------------------
      # Node setup
      # ------------------------
      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      # ------------------------
      # Java setup (required for Gradle 8+)
      # ------------------------
      - name: Setup Java
        id: setup-java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21

      # ------------------------
      # Install dependencies
      # ------------------------
      - name: Install dependencies
        run: npm ci

      # ------------------------
      # Build web app
      # ------------------------
      - name: Build web
        run: npm run build

      # ------------------------
      # Clean Android build (IMPORTANT FIX)
      # prevents missing cordova.variables.gradle
      # ------------------------
      - name: Recreate Android project
        run: |
          rm -rf android
          npx cap add android
          npx cap sync android

      # ------------------------
      # Copy google-services.json (optional)
      # ------------------------
      - name: Add Firebase config
        run: |
          if [ -f "google-services.json" ]; then
            cp google-services.json android/app/google-services.json
          fi

      # ------------------------
      # Decode keystore
      # ------------------------
      - name: Decode keystore
        if: ${{ secrets.ANDROID_KEYSTORE_BASE64 != '' }}
        run: |
          echo "${{ secrets.ANDROID_KEYSTORE_BASE64 }}" | base64 -d > android/app/release.keystore

      # ------------------------
      # Inject signing config (safe version)
      # ------------------------
      - name: Add signing config
        if: ${{ secrets.ANDROID_KEYSTORE_BASE64 != '' }}
        run: |
          python3 <<'PY'
          import pathlib, os

          gradle = pathlib.Path("android/app/build.gradle")
          text = gradle.read_text()

          signing = f"""
android {{
    signingConfigs {{
        release {{
            storeFile file("release.keystore")
            storePassword "{os.environ['KEYSTORE_PASSWORD']}"
            keyAlias "{os.environ['KEY_ALIAS']}"
            keyPassword "{os.environ['KEY_PASSWORD']}"
        }}
    }}

    buildTypes {{
        release {{
            signingConfig signingConfigs.release
        }}
    }}
}}
"""

          if "signingConfigs" not in text:
              text = text.replace("android {", signing, 1)
              gradle.write_text(text)

          PY
        env:
          KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}

      # ------------------------
      # Make gradlew executable
      # ------------------------
      - name: Make gradlew executable
        run: chmod +x android/gradlew

      # ------------------------
      # Build APK
      # ------------------------
      - name: Build APK
        working-directory: android
        run: ./gradlew assembleRelease --stacktrace

      # ------------------------
      # Locate APK
      # ------------------------
      - name: Find APK
        id: apk
        run: |
          APK=$(find android -name "*.apk" | grep release | head -n 1)
          echo "apk_path=$APK" >> $GITHUB_OUTPUT

      # ------------------------
      # Upload artifact
      # ------------------------
      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: app-release-apk
          path: ${{ steps.apk.outputs.apk_path }}
          retention-days: 3
          name: app-release-apk
          path: ${{ steps.apk.outputs.apk_path }}

      # ------------------------
      # GitHub Release
      # ------------------------
      - name: Create Release
        uses: softprops/action-gh-release@v2
        if: startsWith(github.ref, 'refs/tags/')
        with:
          files: ${{ steps.apk.outputs.apk_path }}
          generate_release_notes: true
