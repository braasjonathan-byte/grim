name: Capacitor Android Build (Stable)

on:
  workflow_dispatch:
  push:
    tags:
      - "v*"

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      # ---------------------------
      # Checkout
      # ---------------------------
      - name: Checkout repo
        uses: actions/checkout@v4

      # ---------------------------
      # Node setup
      # ---------------------------
      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      # ---------------------------
      # Java setup (important for Gradle 8+)
      # ---------------------------
      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21

      # ---------------------------
      # Install dependencies (clean & consistent)
      # ---------------------------
      - name: Install dependencies
        run: npm ci

      # ---------------------------
      # Build web app
      # ---------------------------
      - name: Build web
        run: npm run build

      # ---------------------------
      # Ensure Capacitor is installed
      # ---------------------------
      - name: Ensure Capacitor Android installed
        run: |
          npm install @capacitor/core @capacitor/cli @capacitor/android

      # ---------------------------
      # Clean Android project (CRITICAL FIX)
      # avoids cordova.variables.gradle errors
      # ---------------------------
      - name: Recreate Android project clean
        run: |
          rm -rf android
          npx cap add android

      # ---------------------------
      # FULL SYNC (run twice for CI stability)
      # ---------------------------
      - name: Capacitor sync (stable mode)
        run: |
          npx cap sync android
          npx cap sync android

      # ---------------------------
      # Add Firebase config (optional)
      # ---------------------------
      - name: Add google-services.json
        run: |
          if [ -f "google-services.json" ]; then
            cp google-services.json android/app/google-services.json
          fi

      # ---------------------------
      # Decode keystore (if exists)
      # ---------------------------
      - name: Decode keystore
        if: ${{ secrets.ANDROID_KEYSTORE_BASE64 != '' }}
        run: |
          echo "${{ secrets.ANDROID_KEYSTORE_BASE64 }}" | base64 -d > android/app/release.keystore

      # ---------------------------
      # Create signing properties (SAFE METHOD)
      # ---------------------------
      - name: Create signing config
        if: ${{ secrets.ANDROID_KEYSTORE_BASE64 != '' }}
        run: |
          cat >> android/gradle.properties <<EOF
MYAPP_STORE_FILE=release.keystore
MYAPP_STORE_PASSWORD=${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
MYAPP_KEY_ALIAS=${{ secrets.ANDROID_KEY_ALIAS }}
MYAPP_KEY_PASSWORD=${{ secrets.ANDROID_KEY_PASSWORD }}
EOF

      # ---------------------------
      # Make gradle executable
      # ---------------------------
      - name: Make gradlew executable
        run: chmod +x android/gradlew

      # ---------------------------
      # Build APK
      # ---------------------------
      - name: Build release APK
        working-directory: android
        run: ./gradlew assembleRelease --no-daemon

      # ---------------------------
      # Locate APK
      # ---------------------------
      - name: Find APK
        id: apk
        run: |
          APK=$(find android -name "*release*.apk" | head -n 1)
          echo "apk_path=$APK" >> $GITHUB_OUTPUT

      # ---------------------------
      # Upload artifact
      # ---------------------------
      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: app-release-apk
          path: ${{ steps.apk.outputs.apk_path }}

      # ---------------------------
      # GitHub Release (only tags)
      # ---------------------------
      - name: Create Release
        uses: softprops/action-gh-release@v2
        if: startsWith(github.ref, 'refs/tags/')
        with:
          files: ${{ steps.apk.outputs.apk_path }}
          generate_release_notes: true
